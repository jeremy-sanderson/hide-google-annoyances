{
  "name": "hide-google-annoyances",
  "description": "Hides Google's Gemini 'Upgrade' upsell CTA and the Gemini entry-point button on Gmail, Docs, Sheets, Drive, and other Google Workspace pages.",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "NODE_ENV=production wxt build",
    "build:firefox": "NODE_ENV=production wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,md}\" --list-different",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare",
    "checks": "echo format... && npm run format && echo lint... && npm run lint && echo typecheck... && npm run typecheck && echo test && npm run test"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.4",
    "@types/chrome": "^0.1.40",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/ui": "^4.1.5",
    "@wxt-dev/module-react": "^1.1.5",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "wxt": "^0.20.25"
  }
}
